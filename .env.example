# Aegis configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# ---------- Backend: service ----------
AEGIS_APP_NAME="Aegis Backend"
AEGIS_ENVIRONMENT=local          # local | dev | staging | prod
AEGIS_DEBUG=true
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_API_PREFIX=/api/v1

# ---------- Backend: CORS ----------
# Comma-separated list of origins allowed to call the API from a browser.
# Only needed when the frontend is NOT served through a proxy on one origin.
AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ---------- Backend: logging ----------
AEGIS_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_LOG_FORMAT=console          # console | json

# ---------- Storage (reserved) ----------
# PostgreSQL and Redis are NOT required and nothing connects to them yet.
# Setting a URL only changes what /api/v1/health reports.
# AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
# AEGIS_REDIS_URL=redis://localhost:6379/0

# ---------- Frontend ----------
# Relative path keeps the browser on one origin: the Vite dev server and the
# nginx container both proxy /api to the backend.
VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=5000

# Where the Vite dev server proxies API calls during development.
# Point this at a backend running in Docker if the backend is containerised.
BACKEND_URL=http://localhost:8000

# ---------- Optional infrastructure ----------
# Only used by the `infra` compose profile; see docker-compose.yml.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Reserved for later stages (not used yet) ----------
# Deliberately left blank. No AWS or GitHub integration exists in stage 1;
# these names are placeholders for the stages that introduce them.
# GITHUB_TOKEN=
# GITHUB_ORG=
# AWS_REGION=
# AWS_ACCOUNT_ID=
# LLM_API_KEY=
# LLM_MODEL=