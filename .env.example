# Aegis configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
#
# Naming: variables are nested with a double underscore, so `AEGIS_LLM__API_KEY`
# populates `Settings.llm.api_key`. Every variable below is OPTIONAL — the
# service boots with no external dependency configured.
#
# Secrets are held as SecretStr and are masked in logs and error output. They
# are never printed, so if you need to confirm one is set, check that the
# integration reports as configured rather than reading the value back.

# ============ Service ============
AEGIS_APP_NAME="Aegis Backend"
AEGIS_VERSION=0.1.0
AEGIS_ENVIRONMENT=local            # local | dev | staging | prod
AEGIS_DEBUG=true
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_API_PREFIX=/api/v1

# ============ CORS ============
# Comma-separated. Only needed when the frontend is NOT served through a proxy
# on the same origin (the Vite dev server and nginx both proxy /api).
AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ============ Logging ============
AEGIS_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_LOG_FORMAT=console            # console (human) | json (aggregators)
# Only enable behind a proxy you control; otherwise clients can spoof
# X-Forwarded-For in the access log.
AEGIS_TRUST_FORWARDED_HEADERS=false

# ============ Repository analysis ============
# The only directory tree POST /api/repository/analyze may read. A requested
# path must resolve inside this root; ".." and symlinks cannot escape it.
# Defaults to the backend working directory, which is the safe default.
# Point it at a checkout to grant access:
#AEGIS_REPOSITORY_ROOT=/srv/aegis/repos

# ============ LLM ============
# No provider client is implemented yet; these values are read and validated
# only. Prefer injecting the key through the environment or a secret manager
# rather than writing it into this file.
#AEGIS_LLM__PROVIDER=anthropic
#AEGIS_LLM__MODEL=claude-sonnet-5
#AEGIS_LLM__API_KEY=
#AEGIS_LLM__BASE_URL=
#AEGIS_LLM__TEMPERATURE=0.0
#AEGIS_LLM__MAX_TOKENS=4096
#AEGIS_LLM__TIMEOUT_SECONDS=60

# ============ GitHub ============
# No GitHub client is implemented yet and no credentials are read.
#AEGIS_GITHUB__TOKEN=
#AEGIS_GITHUB__ORG=
#AEGIS_GITHUB__API_URL=https://api.github.com
#AEGIS_GITHUB__TIMEOUT_SECONDS=30

# ============ MCP ============
# No MCP servers exist yet. `servers` is a comma-separated list of name=command
# pairs, describing a stdio server the backend would launch.
#AEGIS_MCP__ENABLED=false
#AEGIS_MCP__REQUEST_TIMEOUT_SECONDS=30
#AEGIS_MCP__DESTRUCTIVE_TOOLS_REQUIRE_APPROVAL=true
#AEGIS_MCP__SERVERS=github=python -m mcp_servers.github,docker=docker-mcp

# ============ Database (PostgreSQL-compatible) ============
# No engine or migration runner exists yet; setting a URL changes only what the
# health endpoint reports.
#AEGIS_DATABASE__URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
#AEGIS_DATABASE__POOL_SIZE=5
#AEGIS_DATABASE__MAX_OVERFLOW=10
#AEGIS_DATABASE__ECHO=false
#AEGIS_DATABASE__CONNECT_TIMEOUT_SECONDS=10

# ============ Redis ============
# No client is created yet.
#AEGIS_REDIS__URL=redis://localhost:6379/0
#AEGIS_REDIS__MAX_CONNECTIONS=10
#AEGIS_REDIS__SOCKET_TIMEOUT_SECONDS=5

# ============ AWS ============
# No AWS client is created and boto3 is not a dependency. Prefer a named
# profile or an instance/task role over static keys — see docs/roadmap.md.
#AEGIS_AWS__REGION=eu-west-1
#AEGIS_AWS__ACCOUNT_ID=
#AEGIS_AWS__PROFILE=default
#AEGIS_AWS__ACCESS_KEY_ID=
#AEGIS_AWS__SECRET_ACCESS_KEY=

# ============ Frontend ============
# Relative path keeps the browser on one origin: the Vite dev server and the
# nginx container both proxy /api to the backend.
VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=5000

# Where the Vite dev server proxies API calls during development.
# Point this at a backend running in Docker if the backend is containerised.
BACKEND_URL=http://localhost:8000

# ============ Optional infrastructure (docker compose --profile infra) ============
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432
REDIS_PORT=6379