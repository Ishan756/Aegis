# Aegis configuration — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
#
# Naming: variables are nested with a double underscore, so `AEGIS_LLM__API_KEY`
# populates `Settings.llm.api_key`. Every variable below is OPTIONAL — the
# service boots with no external dependency configured.
#
# Secrets are held as SecretStr and are masked in logs and error output. They
# are never printed, so if you need to confirm one is set, check that the
# integration reports as configured rather than reading the value back.

# ============ Service ============
AEGIS_APP_NAME="Aegis Backend"
AEGIS_VERSION=0.1.0
AEGIS_ENVIRONMENT=local            # local | dev | staging | prod
AEGIS_DEBUG=true
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_API_PREFIX=/api/v1

# ============ CORS ============
# Comma-separated. Only needed when the frontend is NOT served through a proxy
# on the same origin (the Vite dev server and nginx both proxy /api).
AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ============ Logging ============
AEGIS_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_LOG_FORMAT=console            # console (human) | json (aggregators)
# Only enable behind a proxy you control; otherwise clients can spoof
# X-Forwarded-For in the access log.
AEGIS_TRUST_FORWARDED_HEADERS=false

# ============ Repository analysis ============
# The only directory tree POST /api/repository/analyze may read. A requested
# path must resolve inside this root; ".." and symlinks cannot escape it.
# Defaults to the backend working directory, which is the safe default.
# Point it at a checkout to grant access:
#AEGIS_REPOSITORY_ROOT=/srv/aegis/repos

# ============ LLM ============
# No provider client is implemented yet; these values are read and validated
# only. Prefer injecting the key through the environment or a secret manager
# rather than writing it into this file.
#AEGIS_LLM__PROVIDER=anthropic
#AEGIS_LLM__MODEL=claude-sonnet-5
#AEGIS_LLM__API_KEY=
#AEGIS_LLM__BASE_URL=
#AEGIS_LLM__TEMPERATURE=0.0
#AEGIS_LLM__MAX_TOKENS=4096
#AEGIS_LLM__TIMEOUT_SECONDS=60

# ============ GitHub ============
# There is no GitHub client in the backend. The `github` MCP server reads the
# token from the environment and Aegis reaches GitHub only through that server.
# A fine-grained, read-only token is sufficient for everything Aegis does today.
#AEGIS_GITHUB__TOKEN=
#AEGIS_GITHUB__ORG=
#AEGIS_GITHUB__API_URL=https://api.github.com
#AEGIS_GITHUB__TIMEOUT_SECONDS=30

# ============ MCP ============
# Aegis launches stdio MCP servers and exposes their tools, after every call
# passes the execution policy. `servers` is a comma-separated list of
# name=command pairs. Each command is parsed with shell-style quoting but never
# run through a shell, so quote any path that contains spaces.
#
# The demo server ships with the repository and is safe to enable locally.
# Run uvicorn from `backend/`, so the path below is relative to it.
#AEGIS_MCP__ENABLED=false
#AEGIS_MCP__REQUEST_TIMEOUT_SECONDS=30
#AEGIS_MCP__DESTRUCTIVE_TOOLS_REQUIRE_APPROVAL=true
#AEGIS_MCP__SERVERS=demo=python ../mcp_servers/demo_server.py
# Add Docker alongside it. The tools are build/start/stop plus read-only
# inspection; build and start need approval, stop is destructive.
#AEGIS_MCP__SERVERS=demo=python ../mcp_servers/demo_server.py,docker=python ../mcp_servers/docker/server.py
# Add GitHub alongside it (paths are relative to backend/, where uvicorn runs):
#AEGIS_MCP__SERVERS=demo=python ../mcp_servers/demo_server.py,github=python ../mcp_servers/github/server.py

# The MCP SDK inherits only a small allowlist (PATH, HOME and friends), so a
# server cannot read AEGIS_GITHUB__TOKEN unless you name it here. This is an
# opt-in allowlist, not "pass the whole environment", so adding a server cannot
# silently hand it every secret the backend holds. Names only; values are never
# logged. Leave empty to forward nothing.
#AEGIS_MCP__FORWARD_ENVIRONMENT=AEGIS_GITHUB__TOKEN,AEGIS_GITHUB__API_URL
# The Docker server reads its own settings from AEGIS_DOCKER__* variables, so
# those must be forwarded too (the SDK inherits only PATH/HOME by default):
#AEGIS_MCP__FORWARD_ENVIRONMENT=AEGIS_DOCKER__BINARY,AEGIS_DOCKER__CONTEXT_ROOT

# # ============ Docker ============
# The backend holds no Docker client; the `docker` MCP server does. It confines
# every build context to context_root, so a path outside it is refused.
# context_root defaults to the backend working directory. Point it at the
# directory that holds the repositories you intend to deploy.
#AEGIS_DOCKER__BINARY=docker
#AEGIS_DOCKER__CONTEXT_ROOT=../examples
#AEGIS_DOCKER__COMMAND_TIMEOUT_SECONDS=30
#AEGIS_DOCKER__BUILD_TIMEOUT_SECONDS=600
#AEGIS_DOCKER__MAX_OUTPUT_BYTES=64000
#AEGIS_DOCKER__MAX_LOG_LINES=200
#AEGIS_DOCKER__MAX_LOG_BYTES=32000

# ============ Self-healing ============
# Bounded automatic recovery, run after a deployment fails verification.
#
# Every default below is the safe end of its axis. With ENABLED=false the loop
# still investigates and returns an incident report; it just never changes
# anything. Turning it on is a deliberate decision.
#
# Automatic application is limited to non-destructive actions. There is
# deliberately no ALLOW_DESTRUCTIVE or ALLOW_CODE_CHANGES setting: code and
# configuration changes are refused under every configuration, because a flag
# that disables a safety guarantee is worse than no flag.
#AEGIS_SELF_HEALING__ENABLED=false
# Total attempts per incident, capped at 10 by the settings schema. A loop that
# can retry without limit is an outage with extra steps.
#AEGIS_SELF_HEALING__MAX_RECOVERY_ATTEMPTS=2
# low | medium | high. Below this the loop stops and escalates to a human
# instead of acting on a weak hypothesis.
#AEGIS_SELF_HEALING__MIN_CONFIDENCE=medium
#AEGIS_SELF_HEALING__ALLOW_RESTART=true
#AEGIS_SELF_HEALING__ALLOW_RETRY=true
# Off by default and still requires human approval even when enabled: a rebuild
# re-executes the Dockerfile's RUN steps against untrusted input.
#AEGIS_SELF_HEALING__ALLOW_REBUILD=false

# ============ Database (PostgreSQL-compatible) ============
# Deployment history and lessons. Leave the URL unset and history is kept
# in-process only: durable across requests, gone on restart.
#
# Requires the storage extra:  pip install -e '.[storage]'
# The schema is created on startup and is idempotent, so an empty database is
# enough. asyncpg wants a plain postgresql:// DSN — the SQLAlchemy-style
# postgresql+asyncpg:// form is not understood by the driver.
#AEGIS_DATABASE__URL=postgresql://aegis:aegis@localhost:5432/aegis
#AEGIS_DATABASE__POOL_SIZE=5
#AEGIS_DATABASE__MAX_OVERFLOW=10
#AEGIS_DATABASE__ECHO=false
#AEGIS_DATABASE__CONNECT_TIMEOUT_SECONDS=10

# ============ Redis ============
# No client is created yet.
#AEGIS_REDIS__URL=redis://localhost:6379/0
#AEGIS_REDIS__MAX_CONNECTIONS=10
#AEGIS_REDIS__SOCKET_TIMEOUT_SECONDS=5

# ============ AWS ============
# No AWS client is created and boto3 is not a dependency. Prefer a named
# profile or an instance/task role over static keys — see docs/roadmap.md.
#AEGIS_AWS__REGION=eu-west-1
#AEGIS_AWS__ACCOUNT_ID=
#AEGIS_AWS__PROFILE=default
#AEGIS_AWS__ACCESS_KEY_ID=
#AEGIS_AWS__SECRET_ACCESS_KEY=

# ============ Frontend ============
# Relative path keeps the browser on one origin: the Vite dev server and the
# nginx container both proxy /api to the backend.
VITE_API_BASE_URL=/api/v1
# VITE_API_TIMEOUT_MS=5000

# Where the Vite dev server proxies API calls during development.
# Point this at a backend running in Docker if the backend is containerised.
BACKEND_URL=http://localhost:8000

# ============ Optional infrastructure (docker compose --profile infra) ============
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432
REDIS_PORT=6379